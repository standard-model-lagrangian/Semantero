<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The pplx-embed-v2-late service (planner/pplxd.py), only needed while a pplx profile exists.
         A template: pplx/install-service.sh (run by setup-search.sh and `make pplx-setup`) fills in the home
         and checkout paths. Idle cost: a Python process; llama-server unloads the model after 5 idle minutes. -->
    <key>Label</key>
    <string>com.planner.pplxd</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Library/Application Support/Semantero/pplxd-venv/bin/python</string>
        <string>-m</string>
        <string>planner.pplxd</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <!-- Interactive, not Background: it answers queries as you type, and as a Background job macOS kept it on
         efficiency cores with throttled I/O (~2 s a query instead of ~0.25 s, past the app's 3 s timeout). -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/pplxd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/pplxd.log</string>
</dict>
</plist>
