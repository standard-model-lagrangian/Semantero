<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.planner.zotero-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO__/bin/planner-run.sh</string>
        <string>search</string>
        <string>watch-run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>WatchPaths</key>
    <array>
        <string>__ZOTERO__/zotero.sqlite</string>
        <!-- Zotero runs in WAL mode: a new item changes only zotero.sqlite-wal until a checkpoint. -->
        <string>__ZOTERO__/zotero.sqlite-wal</string>
        <string>__ZOTERO__/storage</string>
    </array>
    <!-- launchd starts the job at most this often; a run that only fingerprints takes well under a second. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- Hourly retry for a keyword-only index; exits after a fingerprint check otherwise. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/zotero-watch.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/zotero-watch.log</string>
</dict>
</plist>
