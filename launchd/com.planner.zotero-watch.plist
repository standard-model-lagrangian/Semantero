<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.planner.zotero-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/frederick/Visual Studio /productivity work /bin/planner-run.sh</string>
        <string>search</string>
        <string>watch-run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/frederick/Visual Studio /productivity work </string>
    <key>WatchPaths</key>
    <array>
        <string>/Users/frederick/Zotero/zotero.sqlite</string>
        <string>/Users/frederick/Zotero/storage</string>
    </array>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <!-- Hourly retry for a keyword-only index; exits after a fingerprint check otherwise. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/frederick/Visual Studio /productivity work /logs/zotero-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/frederick/Visual Studio /productivity work /logs/zotero-watch.log</string>
</dict>
</plist>
