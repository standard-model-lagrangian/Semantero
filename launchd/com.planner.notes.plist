<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Keeps the notes index (<vault>/.planner/notes) fresh for the launcher: every 5 minutes and at login.
         Exits at once when the notes index is off or nothing changed. Installed by `make install-global`. -->
    <key>Label</key>
    <string>com.planner.notes</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO__/bin/planner-run.sh</string>
        <string>notes</string>
        <string>tick</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/notes.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/notes.log</string>
</dict>
</plist>
